{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        { "breaking": true, "release": "major" },
        { "type": "revert", "release": "patch" }
      ]
    }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits",
      "presetConfig": {
        "commitUrlFormat": "https://github.com/oddessentials/agent-guild-android/commit/{{hash}}",
        "compareUrlFormat": "https://github.com/oddessentials/agent-guild-android/compare/{{previousTag}}...{{currentTag}}",
        "issueUrlFormat": "https://github.com/oddessentials/agent-guild-android/issues/{{id}}",
        "userUrlFormat": "https://github.com/{{user}}"
      }
    }],
    "./.github/release/capture.mjs"
  ]
}
